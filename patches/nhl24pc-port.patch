+static std::optional<u32> ScalarConstant(const InstOperand& operand) {
+    if (operand.field == OperandField::LiteralConst) {
+        return operand.code;
+    }
+    if ((operand.field == OperandField::ConstZero ||
+         operand.field == OperandField::SignedConstIntPos) &&
+        operand.code >= 128 && operand.code <= 192) {
+        return operand.code - 128;
+    }
+    return std::nullopt;
