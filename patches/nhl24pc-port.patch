+void CFG::LinkJumpTables() {
+    for (const auto& [index, table] : jump_tables) {
+        auto origin = std::ranges::find_if(
+            blocks, [&](const auto& block) { return block.end_index == index; });
+        ASSERT(origin != blocks.end());
+        Block* previous = &*origin;
+        previous->end_class = EndClass::Branch;
+        u32 last_entry = u32(table.targets.size() - 1);
+        while (last_entry > 0 && table.targets[last_entry - 1] == table.targets.back()) {
+            --last_entry;
+        }
+        for (u32 entry = 0; entry <= last_entry; ++entry) {
+            auto target = blocks.find(table.targets[entry], Compare{});
+            ASSERT(target != blocks.end());
+            if (entry == last_entry) {
+                if (previous == &*origin) {
+                    previous->branch_true = &*target;
+                } else {
+                    previous->branch_false = &*target;
+                }
+                target->num_predecessors++;
+                break;
+            }
+            Block* dispatch = block_pool.Create();
+            dispatch->begin = origin->end - 1;
+            dispatch->end = origin->end;
+            dispatch->dispatch_order = entry + 1;
+            dispatch->dispatch_register = table.index_register;
+            dispatch->dispatch_value = table.index_bias + entry * sizeof(s64);
+            dispatch->end_class = EndClass::Branch;
+            dispatch->cond = IR::Condition::Scc1;
+            dispatch->branch_true = &*target;
+            dispatch->num_predecessors = 1;
+            target->num_predecessors++;
+            blocks.insert(*dispatch);
+            if (previous == &*origin) {
+                previous->branch_true = dispatch;
+            } else {
+                previous->branch_false = dispatch;
+            }
+            previous = dispatch;
+        }
+    }
+}
