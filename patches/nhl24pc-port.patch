+bool CFG::ResolveJumpTable(u32 index) {
+    if (index < 3 || program_memory.empty()) {
+        return false;
+    }
+    const auto scalar = [](const InstOperand& operand, u32 reg) {
+        return operand.field == OperandField::ScalarGPR && operand.code == reg;
+    };
+    const auto last_write = [&](u32 before, u32 reg) -> std::optional<u32> {
+        const u32 begin = before > 32 ? before - 32 : 0;
+        for (u32 pos = before; pos-- > begin;) {
+            const auto& inst = inst_list[pos];
+            if (inst.IsTerminateInstruction()) {
+                return std::nullopt;
+            }
+            for (u32 d = 0; d < inst.dst_count; ++d) {
+                if (scalar(inst.dst[d], reg)) {
+                    return pos;
+                }
+            }
+        }
+        return std::nullopt;
+    };
+    const auto& getpc = inst_list[index - 3];
+    const auto& add = inst_list[index - 2];
+    const auto& carry = inst_list[index - 1];
+    const auto& setpc = inst_list[index];
+    const u32 pc_reg = setpc.src[0].code;
+    if (getpc.opcode != Opcode::S_GETPC_B64 || !scalar(getpc.dst[0], pc_reg) ||
+        add.opcode != Opcode::S_ADD_U32 || !scalar(add.dst[0], pc_reg) ||
+        !scalar(add.src[0], pc_reg) || add.src[1].field != OperandField::ScalarGPR ||
+        carry.opcode != Opcode::S_ADDC_U32 || !scalar(carry.dst[0], pc_reg + 1) ||
+        !scalar(carry.src[0], pc_reg + 1) || !scalar(carry.src[1], add.src[1].code + 1)) {
+        return false;
+    }
+    const auto load_pos = last_write(index - 3, add.src[1].code);
+    if (!load_pos) {
+        return false;
+    }
+    const auto& load = inst_list[*load_pos];
+    const auto& smrd = load.control.smrd;
+    if (load.opcode != Opcode::S_LOAD_DWORDX2 || smrd.imm || smrd.offset >= 104) {
+        return false;
+    }
+    const u32 table_reg = load.src[0].code * 2;
+    const auto table_add_pos = last_write(*load_pos, table_reg);
+    if (!table_add_pos || *table_add_pos == 0) {
+        return false;
+    }
+    const auto& table_getpc = inst_list[*table_add_pos - 1];
+    const auto& table_add = inst_list[*table_add_pos];
+    if (*table_add_pos + 1 >= *load_pos) {
+        return false;
+    }
+    const auto& table_carry = inst_list[*table_add_pos + 1];
+    if (table_getpc.opcode != Opcode::S_GETPC_B64 || !scalar(table_getpc.dst[0], table_reg) ||
+        table_add.opcode != Opcode::S_ADD_U32 || table_carry.opcode != Opcode::S_ADDC_U32 ||
+        !scalar(table_carry.dst[0], table_reg + 1) ||
+        !((scalar(table_carry.src[0], table_reg + 1) && ScalarConstant(table_carry.src[1]) == 0) ||
+          (scalar(table_carry.src[1], table_reg + 1) && ScalarConstant(table_carry.src[0]) == 0))) {
+        return false;
+    }
+    const auto constant = scalar(table_add.src[0], table_reg)   ? ScalarConstant(table_add.src[1])
+                          : scalar(table_add.src[1], table_reg) ? ScalarConstant(table_add.src[0])
+                                                                : std::nullopt;
+    const auto index_pos = last_write(*load_pos, smrd.offset);
+    auto shift_pos = index_pos;
+    u32 index_bias = 0;
+    if (index_pos && inst_list[*index_pos].opcode == Opcode::S_ADD_U32) {
+        const auto& bias_add = inst_list[*index_pos];
+        const auto bias = scalar(bias_add.src[0], smrd.offset)
+                              ? ScalarConstant(bias_add.src[1])
+                          : scalar(bias_add.src[1], smrd.offset)
+                              ? ScalarConstant(bias_add.src[0])
+                              : std::nullopt;
+        if (!bias) {
+            return false;
+        }
+        index_bias = *bias;
+        shift_pos = last_write(*index_pos, smrd.offset);
+    }
+    if (!constant || !shift_pos || *shift_pos == 0) {
+        return false;
+    }
+    const auto& shift = inst_list[*shift_pos];
+    const auto& clamp = inst_list[*shift_pos - 1];
+    if (shift.opcode != Opcode::S_LSHL_B32 || !scalar(shift.src[0], smrd.offset) ||
+        ScalarConstant(shift.src[1]) != 3 || clamp.opcode != Opcode::S_MIN_U32 ||
+        !scalar(clamp.dst[0], smrd.offset) || last_write(index - 3, smrd.offset) != index_pos) {
+        return false;
+    }
+    const auto maximum = ScalarConstant(clamp.src[1]);
+    if (!maximum || *maximum > 255 || u64(index_bias) + u64(*maximum) * sizeof(s64) > UINT32_MAX) {
+        return false;
+    }
+    const u64 table_pc =
+        u64(index_to_pc[*table_add_pos - 1]) + table_getpc.length + *constant + index_bias;
+    const u64 table_size = (u64(*maximum) + 1) * sizeof(s64);
+    if (table_pc % alignof(u32) != 0 || table_pc + table_size > program_memory.size_bytes()) {
+        return false;
+    }
+    JumpTable table{smrd.offset, index_bias, {}};
+    std::vector<u64> table_values;
+    const u32 branch_base = index_to_pc[index - 3] + getpc.length;
+    for (u32 entry = 0; entry <= *maximum; ++entry) {
+        s64 offset;
+        std::memcpy(&offset,
+                    reinterpret_cast<const u8*>(program_memory.data()) + table_pc +
+                        entry * sizeof(offset),
+                    sizeof(offset));
+        if (offset < -s64(branch_base) || offset >= s64(index_to_pc.back()) - branch_base) {
+            return false;
+        }
+        const s64 target = s64(branch_base) + offset;
+        if ((target & 3) != 0 ||
+            !std::ranges::binary_search(index_to_pc, u32(target))) {
+            return false;
+        }
+        table.targets.push_back(u32(target));
+        table_values.push_back(u64(offset));
+    }
+    for (const auto target : table.targets) {
+        AddLabel(target);
+    }
+    LOG_INFO(Render_Recompiler, "Resolved indirect jump at {:#x}: {} entries at {:#x}",
+             index_to_pc[index], table.targets.size(), table_pc);
+    jump_tables.emplace(index, std::move(table));
+    inline_tables.emplace(index_to_pc[*load_pos], InlineTable{index_bias, std::move(table_values)});
+    return true;
+}
