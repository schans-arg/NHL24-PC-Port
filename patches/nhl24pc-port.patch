+std::pair<vk::DeviceMemory, u64> BufferCache::AllocateResidency(u64 bytes) {
+    constexpr u64 chunk_size = 64_MB;
+    const auto allocate = [&](u64 size) {
+        const vk::MemoryAllocateFlagsInfo flags = {
+            .flags = vk::MemoryAllocateFlagBits::eDeviceAddress,
+        };
+        const vk::MemoryAllocateInfo info = {
+            .pNext = &flags,
+            .allocationSize = size,
+            .memoryTypeIndex = arena_memory_type_index,
+        };
+        const auto allocation = instance.GetDevice().allocateMemory(info);
+        if (allocation.result != vk::Result::eSuccess) {
+            const auto [used, budget] = instance.QueryMemoryUsage();
+            LOG_ERROR(Render, "Sparse residency allocation failed: {} MiB requested, {} chunks, "
+                              "device memory {} of {} MiB: {}",
+                      size >> 20, residency_allocations, used >> 20, budget >> 20,
+                      vk::to_string(allocation.result));
+        }
+        const auto memory = Vulkan::Check(allocation);
+        ++residency_allocations;
+        if (residency_allocations <= 4 || residency_allocations % 16 == 0) {
+            LOG_INFO(Render, "Sparse residency: {} device allocations, last {} MiB",
+                     residency_allocations, size >> 20);
+        }
+        return memory;
+    };
+    if (bytes > chunk_size) {
+        return {allocate(bytes), 0};
+    }
+    if (residency_used + bytes > residency_size) {
+        residency_memory = allocate(chunk_size);
+        residency_size = chunk_size;
+        residency_used = 0;
+    }
+    const u64 offset = residency_used;
+    residency_used += bytes;
+    return {residency_memory, offset};
+}
